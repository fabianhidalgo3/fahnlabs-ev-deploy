# Production settings for deploy/docker-compose.prod.yml. Copy to deploy/.env on the server (git-ignored).
# deploy/deploy.ps1 generates this file with random secrets on the first deployment.

# Public host name (DNS A record → server IP)
DOMAIN=example.com
# Server IP: also served with a self-signed certificate (and ws:// OCPP on port 80) for access before/without DNS
PUBLIC_IP=

# Dashboard login (HTTP basic auth in Caddy). The hash is bcrypt: docker run --rm caddy:2 caddy hash-password
UI_USER=admin
UI_PASSWORD_HASH=
# Random secret of the 30-day session cookie set after the login (openssl rand -hex 32); changing it logs everyone out
SESSION_TOKEN=

# Databases (only reachable inside the compose network)
POSTGRES_DB=emob
POSTGRES_USER=emob
POSTGRES_PASSWORD=
MONGO_USER=emob
MONGO_PASSWORD=

# Shared secrets between services
GATEWAY_TOKEN=
MOTOR_TOKEN=

# AI assistant (optional): Claude, or free Google Gemini when ANTHROPIC_API_KEY is empty
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Tried in order when the main model is busy, retired or slow
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.8-flash,gemini-flash-latest
