# Copy as .env (ignored by git). Read by docker compose and by the motor.

# Databases (docker-compose.yml). Host ports avoid clashing with other local databases.
POSTGRES_DB=emob
POSTGRES_USER=emob
POSTGRES_PASSWORD=emob-dev
POSTGRES_PORT=5442
MONGO_USER=emob
MONGO_PASSWORD=emob-dev
MONGO_PORT=27027

# OCPP gateway
# GATEWAY_PORT=9100
# GATEWAY_TOKEN=          # shared secret with the motor (X-Gateway-Token); set the same value below
# EMULATOR_DIR=           # folder of the web emulator (found automatically)

# Motor
# MOTOR_PORT=9200
# MOTOR_TOKEN=            # shared secret with the BFF (X-Motor-Token); set the same value in bff/.env
# GATEWAY_URL=http://localhost:9100
# GATEWAY_TOKEN=
# POSTGRES_URL=postgres://emob:emob-dev@127.0.0.1:5442/emob?sslmode=disable
# MONGO_URI=mongodb://emob:emob-dev@127.0.0.1:27027/?authSource=admin
